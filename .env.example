# 复制为 .env 并填入真实值
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODELS=glm-4.5-flash
GLM_VISION_MODEL=glm-4v-flash
GLM_IMAGE_MODEL=cogview-3-flash

SECRET_KEY=change-me
DEBUG=1

LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2
LLM_TRUST_ENV=0

# 宠物 TTS 音色：以下为 2026-10-11 真实接口实测通过的 voice ID（同一句文本均返回 200 + wav）
# 可选系统音色：tongtong(女·明亮) / chuichui(男·沉稳) / xiaochen(女·俏皮) / jam(男·爽朗)
PET_TTS_VOICE_1=tongtong
PET_TTS_VOICE_2=jam
PET_TTS_VOICE_3=xiaochen
PET_TTS_VOICE_4=chuichui
